{
  "name": "actually-relevant-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/install-dev-deps.mjs && node node_modules/typescript/bin/tsc --version && node node_modules/typescript/bin/tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap:generate": "npx tsx scripts/generate-sitemap.ts",
    "images:info": "node scripts/images.mjs info",
    "images:optimize": "node scripts/images.mjs optimize",
    "images:optimize-single": "node scripts/images.mjs optimize-single",
    "images:clean": "node scripts/images.mjs clean",
    "images:og": "npx tsx scripts/generate-og-image.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@scalar/api-reference-react": "^0.9.81",
    "@tanstack/react-query": "^5.90.20",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
