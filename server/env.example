# To generate links, e.g. to confirm newsletter subscriptions
API_URL="https://actually-relevant-api.onrender.com"

# Site URL for links in posts
SITE_URL="https://actuallyrelevant.news"

# Frontend URL for CORS
FRONTEND_URL="https://actuallyrelevant.news"
# Server port (optional, defaults to 3001 locally, Render sets automatically)
PORT=3001
JWT_SECRET=[at least 32 characters]
# PUBLIC_API_KEY=optional-api-key-for-public-access-of-protected-routes

# Database (PostgreSQL with pgvector)
# Local development: the Docker database from docker-compose.yml (`docker compose up -d`);
# the password is POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL="postgresql://ardev:<password>@localhost:5433/actually_relevant_dev?schema=public"
# Production: Render's internal database URL, copied from the Render dashboard (never commit it)

# Starting the dev server runs `db:prepare` (apply migrations, regenerate the Prisma client)
# when DATABASE_URL points at localhost. Set to 1/true/yes to skip it. Optional, default: unset
# SKIP_DB_PREPARE=1

# Services
OPENAI_API_KEY="sk-..."
DIFFBOT_TOKEN=your_token_here
PIPFEED_API_KEY=

PLUNK_SECRET_KEY=sk_...
PLUNK_PUBLIC_KEY=pk_...
PLUNK_FROM_EMAIL=newsletter@actuallyrelevant.news  # Must be a verified sender in Plunk
PLUNK_TEST_SEGMENT_ID=

BLUESKY_AUTO_POST_ENABLED=true
BLUESKY_HANDLE=actuallyrelevant.bsky.social
BLUESKY_APP_PASSWORD=

MASTODON_AUTO_POST_ENABLED=true
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=""

# Alerts: webhook for job failure and event notices (optional; silent when unset).
# Required when PODCAST_ENABLED=true: the podcast configuration check fails without it.
WEBHOOK_URL=

# Podcast (see .plans/autonomous-two-speaker-podcast.md, "Owner's one-time manual steps")
# Only secrets and the kill switch live here; every other podcast setting (voice ids, audio base URL,
# monthly TTS cap, attempts per week, feed contact, artwork) is a constant in config.podcast
# (server/src/config.ts). Dry run is derived from NODE_ENV: on unless NODE_ENV=production.
# Kill switch for generation, TTS and publishing; flip it in the Render dashboard, no code change. Default: false
PODCAST_ENABLED=false
# Dev only: real voices in a dry run (spends ElevenLabs credits). Default: false
PODCAST_DRY_RUN_LIVE_TTS=false
# Dedicated, restricted ElevenLabs key: text-to-speech/dialogue and user read only
# (user read is needed for the balance check via GET /v1/user/subscription). Required when enabled
ELEVENLABS_API_KEY=
# Bunny Storage zone name and its zone password (write access; not the account API key). Required when enabled
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
