# Public API base URL, shown as the server in the OpenAPI spec
API_URL="https://api.actuallyrelevant.news"

# Site URL for links in posts
SITE_URL="https://actuallyrelevant.news"

# Frontend URL for CORS
FRONTEND_URL="https://actuallyrelevant.news"
# Server port (optional, defaults to 3001 locally, Render sets automatically)
PORT=3001
JWT_SECRET=[at least 32 characters]
# PUBLIC_API_KEY=optional-api-key-for-public-access-of-protected-routes
# Refresh-cookie SameSite: strict | lax | none. Unset: none in production, strict in development.
# Set strict once the API is served from the admin's site (see .context/authentication.md). Optional
# AUTH_COOKIE_SAMESITE=strict

# Database (PostgreSQL with pgvector)
# Local development: the Docker database from docker-compose.yml (`docker compose up -d`);
# the password is POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL="postgresql://ardev:<password>@localhost:5433/actually_relevant_dev?schema=public"
# Production: Render's internal database URL, copied from the Render dashboard (never commit it)

# Starting the dev server runs `db:prepare` (apply migrations, regenerate the Prisma client)
# when DATABASE_URL points at localhost. Set to 1/true/yes to skip it. Optional, default: unset
# SKIP_DB_PREPARE=1

# Scheduler on/off. Set to false (also 0/no/off) for a second process run against the production
# database, so that it schedules no job and sends no boot podcast-configuration alert; the admin
# Run button still works there (the job lease keeps it from overlapping the main instance).
# Optional, default: on (see .context/scheduler.md, "Disabling the scheduler")
# SCHEDULER_ENABLED=false

# Cross-instance job lease, in whole seconds: how long a run's lease lasts, and how often a running
# job renews it. The renewal interval must be at most half the lease, or the server refuses to start.
# Optional, default: 120 and 30 (see .context/scheduler.md, "Overlap prevention"; ADR-0020)
# JOB_LEASE_SECONDS=120
# JOB_LEASE_RENEW_SECONDS=30

# Services
OPENAI_API_KEY="sk-..."
DIFFBOT_TOKEN=your_token_here
PIPFEED_API_KEY=

PLUNK_SECRET_KEY=sk_...
PLUNK_PUBLIC_KEY=pk_...
PLUNK_FROM_EMAIL=newsletter@actuallyrelevant.news  # Must be a verified sender in Plunk
PLUNK_TEST_SEGMENT_ID=

# Newsletter signups (see .context/subscription.md)
# Signups are closed unless this is exactly "true"; unset means paused
SUBSCRIPTIONS_ENABLED=
# Cloudflare Turnstile secret for the signup check. Required in production (empty refuses every
# signup); empty elsewhere skips the check. Local test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# At most one confirmation email per address within this many hours. Optional, default: 24
# SUBSCRIBE_PER_ADDRESS_WINDOW_HOURS=24
# At most this many confirmation emails per rolling hour across all addresses. Optional, default: 30
# SUBSCRIBE_GLOBAL_HOURLY_MAX=30

BLUESKY_AUTO_POST_ENABLED=true
BLUESKY_HANDLE=actuallyrelevant.bsky.social
BLUESKY_APP_PASSWORD=

MASTODON_AUTO_POST_ENABLED=true
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=""

# Alerts: webhook for job failure and event notices (optional; silent when unset).
# Not required by any job: unset, failures and podcast notices show only in the admin (Jobs and
# Podcasts pages), and the Jobs page warns while a podcast job is enabled.
WEBHOOK_URL=

# Podcast (see .context/podcast.md, "Owner setup and environment" and "Automation")
# Only secrets live here; every other podcast setting (voice ids, audio base URL, monthly TTS cap,
# attempts per week, feed contact, artwork) is a constant in config.podcast (server/src/config.ts).
# On/off is the generate_podcast and publish_podcast job rows in the admin Jobs page (seeded disabled).
# Dry run is derived from NODE_ENV (on unless NODE_ENV=production) and always uses a silent stub voice.
# Dedicated, restricted ElevenLabs key: text-to-speech/dialogue and user read only
# (user read is needed for the balance check via GET /v1/user/subscription).
# Required once a podcast job is enabled or an admin podcast action runs
ELEVENLABS_API_KEY=
# Bunny Storage zone name and its zone password (write access; not the account API key). Same requirement
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
