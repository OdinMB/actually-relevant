generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// --- Enums ---

enum StoryStatus {
  fetched
  pre_analyzed
  analyzed
  selected
  published
  rejected
  trashed
}

// Why a story is `rejected` (null on every other status, enforced by a CHECK constraint).
// Only `duplicate` rejections are restored when a cluster is dissolved (.context/dedup.md).
enum RejectionReason {
  paywall
  assess_threshold
  select_threshold
  selection
  duplicate
  editor
  /// The research step's verdicts (.context/story-research.md, "The pipeline step"), each only from `selected`.
  /// `research_rating` is no longer written (a rating below the bar rejects nothing); kept, since dropping an enum value is destructive
  research_rating
  stale
  contradicted
}

enum EmotionTag {
  uplifting
  frustrating
  scary
  calm
}

enum FeedRegion {
  north_america
  western_europe
  eastern_europe
  middle_east_north_africa
  sub_saharan_africa
  south_southeast_asia
  pacific
  latin_america
  global
}

enum ContentStatus {
  draft
  published
}

enum UserRole {
  admin
  editor
  viewer
}

// --- Core Tables ---

model Story {
  id                     String       @id @default(uuid())
  sourceUrl              String       @unique @map("source_url")
  sourceTitle            String       @map("source_title")
  sourceContent          String       @map("source_content")
  sourceDatePublished    DateTime?    @map("source_date_published")
  feedId                 String       @map("feed_id")
  feed                   Feed         @relation(fields: [feedId], references: [id])
  issueId                String?      @map("issue_id")
  issue                  Issue?       @relation(fields: [issueId], references: [id])
  status                 StoryStatus  @default(fetched)
  rejectionReason        RejectionReason? @map("rejection_reason")
  /// When the story last entered `selected`, set by the lifecycle's move only; the publish gate's longest wait counts from it
  selectedAt             DateTime?    @map("selected_at")
  dateCrawled            DateTime     @default(now()) @map("date_crawled")
  datePublished          DateTime?    @map("date_published")
  relevancePre           Int?         @map("relevance_pre")
  relevance              Int?
  emotionTag             EmotionTag?  @map("emotion_tag")
  slug                   String?      @unique
  title                  String?
  titleLabel             String?      @map("title_label")
  summary                String?
  quote                  String?
  quoteAttribution       String?      @map("quote_attribution")
  marketingBlurb         String?      @map("marketing_blurb")
  relevanceReasons       String?      @map("relevance_reasons")
  relevanceSummary       String?      @map("relevance_summary")
  antifactors            String?
  relevanceCalculation   String?      @map("relevance_calculation")
  // The researched version readers see, with its citations and sources (services/researchedStory.ts,
  // .context/story-research.md, "Reader format"); null unless a research run was applied
  research               Json?        @map("research")
  // Every field an applied research run replaced, so a revert restores the single-source analysis;
  // set while the text fields carry researched text (the public `researched` flag)
  preResearch            Json?        @map("pre_research")
  crawlMethod            String?      @map("crawl_method")
  accessTier             String?      @map("access_tier")
  // The vector lives in its own table so writes to `stories` never touch the HNSW index (ADR-0051)
  embedding              StoryEmbedding?
  clusterId             String?      @map("cluster_id")
  cluster                StoryCluster? @relation("ClusterMember", fields: [clusterId], references: [id])
  primaryOfCluster       StoryCluster? @relation("ClusterPrimary")
  blueskyPosts           BlueskyPost[]
  mastodonPosts          MastodonPost[]
  feedback               Feedback[]
  researchRuns           StoryResearchRun[]
  contextRuns            StoryContextRun[]
  contextFacts           ContextFact[]
  contextBoxes           ContextBox[]
  researchPasses         ResearchPass[]
  evidenceSearches       EvidenceSearch[]
  evidenceSources        EvidenceSource[]
  poolFacts              PoolFact[]
  articleVersions        ArticleVersion[]
  passBoxes              PassBox[]
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@index([status, dateCrawled])
  @@index([feedId])
  @@index([status, relevancePre])
  @@index([status, relevance])
  @@index([datePublished])
  // Newest published first (homepage, public lists): walking `datePublished` alone reads every
  // unpublished row first, since their NULL dates lead a descending scan.
  @@index([status, datePublished, dateCrawled])
  @@index([issueId])
  @@index([clusterId])
  @@map("stories")
}

// One embedding per story, read and written with raw SQL (`server/src/lib/vectors.ts`).
// Kept out of `stories` on purpose: Postgres adds an entry to every index of a row an UPDATE
// writes to an indexed column, so with the vector on `stories` every status move re-inserted it
// into the HNSW graph (ADR-0051). Never move the vector back or index it there.
// The HNSW index `story_embeddings_embedding_idx` (vector_cosine_ops) is raw SQL in the
// 20261102120000_story_embeddings_table migration; Prisma can't model it, so a generated
// migration proposes `DROP INDEX "story_embeddings_embedding_idx"`: delete that line.
model StoryEmbedding {
  storyId     String                      @id @map("story_id")
  embedding   Unsupported("vector(1536)")
  // SHA-256 hex of the embedded content; empty when unknown (the next ensure regenerates it)
  contentHash String                      @db.VarChar(64) @map("content_hash")
  generatedAt DateTime                    @default(now()) @map("generated_at")
  story       Story                       @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_embeddings")
}

model StoryCluster {
  id             String   @id @default(uuid())
  primaryStoryId String?  @unique @map("primary_story_id")
  primaryStory   Story?   @relation("ClusterPrimary", fields: [primaryStoryId], references: [id])
  stories        Story[]  @relation("ClusterMember")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("story_clusters")
}

model Feed {
  id                 String    @id @default(uuid())
  title              String
  rssUrl             String    @unique @map("rss_url")
  url                String?
  displayTitle       String?   @map("display_title")
  language           String    @default("en")
  region             FeedRegion?
  issueId            String    @map("issue_id")
  issue              Issue     @relation(fields: [issueId], references: [id])
  active             Boolean   @default(true)
  crawlIntervalHours Int       @default(24) @map("crawl_interval_hours")
  lastCrawledAt      DateTime? @map("last_crawled_at")
  lastCrawlError          String?   @map("last_crawl_error")
  lastCrawlErrorAt        DateTime? @map("last_crawl_error_at")
  consecutiveFailedCrawls Int       @default(0) @map("consecutive_failed_crawls")
  consecutiveEmptyCrawls  Int       @default(0) @map("consecutive_empty_crawls")
  lastSuccessfulCrawlAt   DateTime? @map("last_successful_crawl_at")
  lastEtag                String?   @map("last_etag")
  lastModified            String?   @map("last_modified")
  lastCrawlResult         String?   @map("last_crawl_result")
  htmlSelector            String?   @map("html_selector")
  paywallDetection        Boolean   @default(true) @map("paywall_detection")
  paywallTitleMarker      String?   @map("paywall_title_marker")
  // Where the crawler takes the article text: 'page' (fetch the article page) or 'rss' (the full
  // text in the RSS item, never fetching the page). Checked by Zod in schemas/feed.ts, not an enum.
  contentSource           String    @default("page") @map("content_source")
  stories            Story[]
  favicon            FeedFavicon?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("feeds")
}

// A feed's favicon as a 32 px PNG, served by GET /api/feeds/:id/favicon (.context/feed-management.md,
// "Favicons"). A table of its own, so that loading feeds never loads the bytes.
model FeedFavicon {
  feedId    String   @id @map("feed_id")
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  png       Bytes
  // The image the PNG was made from (the Google favicon API, a <link rel=icon> href or /favicon.ico)
  sourceUrl String   @map("source_url")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("feed_favicons")
}

// A research source's favicon by host, as a 32 px PNG, served by GET /api/source-favicons/:host
// (services/sourceFavicons.ts). A null `png` records "looked, none found", so the host is not
// looked up again until `fetchedAt` is 30 days old.
model SourceFavicon {
  host      String   @id
  png       Bytes?
  // The image the PNG was made from; null when none was found
  sourceUrl String?  @map("source_url")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("source_favicons")
}

model Issue {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String   @default("")
  promptFactors      String   @default("") @map("prompt_factors")
  promptAntifactors  String   @default("") @map("prompt_antifactors")
  promptRatings      String   @default("") @map("prompt_ratings")
  parentId           String?  @map("parent_id")
  parent             Issue?   @relation("IssueHierarchy", fields: [parentId], references: [id])
  children           Issue[]  @relation("IssueHierarchy")
  intro              String   @default("")
  evaluationIntro    String   @default("") @map("evaluation_intro")
  evaluationCriteria String   @default("") @map("evaluation_criteria")
  makeADifference    String   @default("") @map("make_a_difference")
  minPreRating       Int?     @map("min_pre_rating")
  feeds              Feed[]
  stories            Story[]
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("issues")
}

model Newsletter {
  id        String           @id @default(uuid())
  title     String
  content   String           @default("")
  html      String           @default("")
  storyIds          String[]         @map("story_ids")
  selectedStoryIds  String[]         @default([]) @map("selected_story_ids")
  status            ContentStatus    @default(draft)
  /// ISO week (YYYY-Www) of the automatic weekly issue; set only by the generate_newsletter job
  weekKey   String?          @map("week_key")
  /// URL segment of the public web edition (/newsletter/<slug>); assigned on HTML build or first publish, never changed
  slug        String?        @unique
  /// The public archive's date: the first live send if the issue was emailed, else when it was first set to published; kept when unpublished
  publishedAt DateTime?      @map("published_at")
  /// Which edition the issue is (ADR-0052): its stories, its audience in Plunk, its subject and slug prefix
  edition   NewsletterEdition @default(full)
  sends     NewsletterSend[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("newsletters")
}

/// The newsletter's two editions (ADR-0052): `full`, every kind of story, and `uplifting`, Actually Uplifting's uplifting stories only
enum NewsletterEdition {
  full
  uplifting
}

enum NewsletterSendStatus {
  draft
  scheduled
  sending
  sent
  failed
}

model NewsletterSend {
  id              String               @id @default(uuid())
  newsletterId    String               @map("newsletter_id")
  newsletter      Newsletter           @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  plunkCampaignId String?              @map("plunk_campaign_id")
  isTest          Boolean              @default(false) @map("is_test")
  status          NewsletterSendStatus @default(draft)
  htmlContent     String               @map("html_content")
  stats           Json                 @default("{}")
  errorMessage    String?              @map("error_message")
  sentAt          DateTime?            @map("sent_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([newsletterId])
  @@index([plunkCampaignId])
  @@map("newsletter_sends")
}

/// Production progress of a podcast episode (forward-only; `legacy` = rows from before the two-speaker pipeline).
/// Publication is the separate `status` axis.
enum PodcastStage {
  legacy
  created
  selected
  scripted
  voiced
  ready
}

/// How far a run goes: automated runs straight to `ready`; interactive stops after `selected` and `scripted` for review
enum PodcastMode {
  automated
  interactive
}

/// weekly: this ISO week's episode (the jobs' only kind); standalone: built by hand from any published stories, never touched by the jobs (ADR-0016)
enum PodcastKind {
  weekly
  standalone
}

/// The podcast's two shows (`services/podcastEdition.ts`): `full`, "Actually Relevant", and `uplifting`, "Actually Uplifting", made from the week's uplifting stories only
enum PodcastEdition {
  full
  uplifting
}

model Podcast {
  id             String        @id @default(uuid())
  title          String
  /// Legacy rows: the hand-voiced script. Two-speaker rows: the rendered dialogue ("HOST A: ...") for the admin.
  script         String        @default("")
  storyIds       String[]      @map("story_ids")
  status         ContentStatus @default(draft)
  /// ISO week in UTC (YYYY-Www) of the weekly episode, unique per show; null for legacy and standalone rows
  weekKey        String?       @map("week_key")
  /// Weekly or standalone; a CHECK (podcasts_standalone_without_week_key) keeps a standalone row's week key null
  kind           PodcastKind   @default(weekly)
  /// Which show the episode belongs to; a CHECK (podcasts_standalone_full_edition) keeps standalone episodes on the main show
  edition        PodcastEdition @default(full)
  stage          PodcastStage  @default(created)
  /// The model's dialogue (segments of turns, storyRef = episodeStories[].ref)
  dialogue       Json?
  /// Snapshot of the episode's stories (ref, id, title, publisher, sourceUrl, slug, issue), frozen at scripting
  episodeStories Json?         @map("episode_stories")
  episodeSummary String        @default("") @map("episode_summary")
  showNotes      String        @default("") @map("show_notes")
  scriptModelId  String?       @map("script_model_id")
  lastError      String?       @map("last_error")
  failedAt       DateTime?     @map("failed_at")
  /// Automatic (cron) failures this week; reset by an admin Resume
  attempts       Int           @default(0)
  blockedAt      DateTime?     @map("blocked_at")
  blockedReason  String?       @map("blocked_reason")
  /// Cross-process lease on the stage machine: owner = a per-process id, until = database clock
  leaseOwner     String?       @map("lease_owner")
  leaseUntil     DateTime?     @map("lease_until")
  dryRun         Boolean       @default(false) @map("dry_run")
  /// TTS model and voices the episode was voiced with (stored at `voiced`)
  ttsModelId     String?       @map("tts_model_id")
  voiceIds       Json?         @map("voice_ids")
  /// Public CDN URLs and storage paths of the MP3 and the VTT transcript (stored at `ready`); a fresh file name per render
  audioUrl       String?       @map("audio_url")
  audioPath      String?       @map("audio_path")
  transcriptUrl  String?       @map("transcript_url")
  transcriptPath String?       @map("transcript_path")
  /// Public CDN URL and storage path of the Podcasting 2.0 JSON chapters file (stored at `ready`); null on episodes from before chapters
  chaptersUrl    String?       @map("chapters_url")
  chaptersPath   String?       @map("chapters_path")
  audioBytes     Int?          @map("audio_bytes")
  durationSec    Int?          @map("duration_sec")
  readyAt        DateTime?     @map("ready_at")
  /// Null until a person (or the cron run) chooses how far runs go
  mode           PodcastMode?
  /// A person changed the stories or the script text; selects the episode's AI line
  humanEdited    Boolean       @default(false) @map("human_edited")
  /// TTS seed of the current render; null = config.podcast.ttsSeed. A fresh one per "Regenerate audio"
  ttsSeed        Int?          @map("tts_seed")
  /// When the stories were selected: the end of the week's pool the model chose from, which the story picker lists too
  storiesSelectedAt DateTime?  @map("stories_selected_at")
  /// First publication; once set the episode is never regenerated or deleted (its GUID and enclosure are permanent)
  publishedAt    DateTime?     @map("published_at")
  /// Last takedown; the automatic publish job never republishes an episode that has one
  unpublishedAt  DateTime?     @map("unpublished_at")
  /// When the generate_podcast job reminded the owner that this interactive episode waits for him (once per week)
  reviewReminderSentAt DateTime? @map("review_reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  audioChunks PodcastAudioChunk[]
  ttsUsage    PodcastTtsUsage[]

  @@unique([edition, weekKey])
  @@map("podcasts")
}

/// One voiced TTS chunk of an episode, kept until the episode's MP3 is assembled and uploaded (`ready`)
model PodcastAudioChunk {
  id         String   @id @default(uuid())
  podcastId  String   @map("podcast_id")
  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  index      Int
  bytes      Bytes
  requestId  String?  @map("request_id")
  chars      Int
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([podcastId, index])
  @@map("podcast_audio_chunks")
}

/// TTS spend ledger: one row per reserved TTS call, kept whatever the call's outcome and after the episode is deleted
model PodcastTtsUsage {
  id        String   @id @default(uuid())
  podcastId String?  @map("podcast_id")
  podcast   Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  chars     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("podcast_tts_usage")
}

enum ResearchRunStatus {
  running
  completed
  failed
}

/// Who started a research run: an editor's Research button, or the research_stories job
enum ResearchRunTrigger {
  editor
  pipeline
}

/// One story research run, an editor's or the research_stories job's (.context/story-research.md). Every run is kept; a deleted story's runs keep a null story_id, so the month's spend still counts them. `cost_usd` holds the run's reservation while it runs, then its measured cost
model StoryResearchRun {
  id            String             @id @default(uuid())
  storyId       String?            @map("story_id")
  story         Story?             @relation(fields: [storyId], references: [id], onDelete: SetNull)
  status        ResearchRunStatus  @default(running)
  /// A pipeline run settles the publish gate for its story (services/researchQueue.ts)
  trigger       ResearchRunTrigger @default(editor)
  /// The gate verdict's kind; null until the run finishes
  verdict       String?
  costUsd       Float              @map("cost_usd")
  tavilyCredits Int                @default(0) @map("tavily_credits")
  /// The run's StoryResearch, with the model ids and prices it used
  result        Json?
  /// Why a run failed, sanitized: never fetched text
  error         String?
  startedAt     DateTime           @default(now()) @map("started_at")
  finishedAt    DateTime?          @map("finished_at")
  contextRuns   StoryContextRun[]

  @@index([storyId, startedAt])
  @@index([startedAt])
  @@map("story_research_runs")
}

/// How long a context fact stays current, from its as-of date (.context/story-context.md, "Validity")
enum ContextValidity {
  fixed
  slow
  fast
}

/// The fact check's answer on a context fact; only `supported` facts are ever offered or shown
enum ContextVerdict {
  supported
  rejected
  unjudged
}

/// A judgment record's status (the overviews roadmap's record): `demoted` is never served
enum JudgmentStatus {
  unreviewed
  reviewed
  demoted
}

/// A context box's slot. `figures` is the In numbers box written until 2026-11-17: kept for its stored rows, never read back
enum ContextBoxType {
  compared
  why_now
  build_up
  who_affected
  response
  next
  key_term
  figures
}

enum ContextRunStatus {
  running
  completed
  skipped
  failed
}

/// One story context run (.context/story-context.md): the step's or an editor's. The step settles a story with its first run, whatever its outcome; an editor may run it again, and each run builds on the story's earlier completed ones. At most one runs per story at a time. A deleted story's runs keep a null story_id, so their cost stays counted
model StoryContextRun {
  id            String            @id @default(uuid())
  storyId       String?           @map("story_id")
  story         Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  /// The completed research run whose facts the run read
  researchRunId String?           @map("research_run_id")
  researchRun   StoryResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)
  status        ContextRunStatus  @default(running)
  /// built, none-kept, no-research or technical; null while running
  outcome       String?
  boxes         Int               @default(0)
  /// model_usd plus the web search credits at their price: an upper bound, model calls at standard price
  costUsd       Float             @default(0) @map("cost_usd")
  modelUsd      Float             @default(0) @map("model_usd")
  tavilyCredits Int               @default(0) @map("tavily_credits")
  /// What the run did: gap list, searches, filter drops, verdicts, box drops, number hints, item tally, calls
  result        Json?
  /// Why a run failed, sanitized: never fetched text
  error         String?
  startedAt     DateTime          @default(now()) @map("started_at")
  finishedAt    DateTime?         @map("finished_at")
  facts         ContextFact[]
  contextBoxes  ContextBox[]

  @@index([storyId])
  @@index([startedAt])
  @@map("story_context_runs")
}

/// One fact a context run structured (pass 1, from research's facts) or extracted (pass 2, from its own search), with its check's verdict. Only the supporting sentence and a short passage are kept, never a page's text
model ContextFact {
  id                 String          @id @default(uuid())
  storyId            String          @map("story_id")
  story              Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  runId              String          @map("run_id")
  run                StoryContextRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The fact's id within its run, as boxes cite it: research's own (`S2F3`) for pass 1, the next source numbers for pass 2
  ref                String
  /// research (pass 1) or search (pass 2)
  origin             String
  /// The fact this one was copied from, when a kept box cited a reused one: an earlier story's, or one of this story's earlier runs'
  reusedFromId       String?         @map("reused_from_id")
  sourceUrl          String          @map("source_url")
  sourceOutlet       String          @map("source_outlet")
  sourceTitle        String          @map("source_title")
  sourceDate         DateTime?       @map("source_date") @db.Date
  sourceKind         String          @map("source_kind")
  /// Copied verbatim from the source
  supportingSentence String          @map("supporting_sentence")
  /// Pass 2 only: the sentence with one sentence either side, at most 600 characters
  passage            String?
  /// The supporting sentence was found word for word in the fetched text
  supportFound       Boolean         @default(false) @map("support_found")
  statement          String
  value              Float?
  valueHigh          Float?          @map("value_high")
  unit               String          @default("")
  /// exact, about, at_least or under
  approx             String          @default("exact")
  provisional        Boolean         @default(false)
  counted            String          @default("")
  place              String          @default("")
  asOf               DateTime?       @map("as_of") @db.Date
  /// day, month or year; null without an as-of date
  asOfPrecision      String?         @map("as_of_precision")
  credited           String          @default("")
  /// official, research, news or other; null when nobody is credited
  creditedKind       String?         @map("credited_kind")
  validity           ContextValidity @default(fixed)
  verdict            ContextVerdict
  verdictProblem     String?         @map("verdict_problem")
  status             JudgmentStatus  @default(unreviewed)
  model              String
  promptVersion      String          @map("prompt_version")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([runId, ref])
  @@index([storyId])
  @@map("context_facts")
}

/// One context box a run wrote: a card on the story page (.context/story-context.md). Sentences and visuals cite their run's facts by ref
model ContextBox {
  id            String          @id @default(uuid())
  storyId       String          @map("story_id")
  story         Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  runId         String          @map("run_id")
  run           StoryContextRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position      Int
  type          ContextBoxType
  heading       String
  teaser        String          @default("")
  /// [{ text, factIds }], each fact id a ref of the box's run
  sentences     Json
  /// A validated tiles, bars or line spec citing fact refs, or null
  visual        Json?
  /// Unused since 2026-11-17: no honest-gap card is written or served (ADR-0065); kept, as dropping it would be a destructive migration
  gap           Boolean         @default(false)
  /// The newest as-of date of its cited facts
  asOf          DateTime?       @map("as_of") @db.Date
  asOfPrecision String?         @map("as_of_precision")
  /// P<n>, W<n>, or null for the More context section, as the write call chose it or an editor moved it
  place         String?
  placeByEditor Boolean         @default(false) @map("place_by_editor")
  status        JudgmentStatus  @default(unreviewed)
  /// Null for the honest gap, which code adds
  model         String?
  promptVersion String?         @map("prompt_version")
  writtenAt     DateTime        @default(now()) @map("written_at")

  @@index([storyId])
  @@map("context_boxes")
}

/// Story context's answered web searches, reused for 7 days at no credit cost; rows past that are deleted at each run's start. Only results that passed the opt-out check are kept
model ContextSearchCache {
  /// sha256 of the normalized query, depth, topic and recent flag
  key       String   @id
  query     String
  /// [{ url, title, date, text }]
  results   Json
  credits   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("context_search_cache")
}

// --- Research passes (.context/research-passes.md, ADR-0067) ---
// One repeatable step over one evidence pool per story. Every row carries the pass that wrote it, its
// provenance. Evidence (what was fetched) is kept word for word, never a page's text; every model
// answer carries its model and prompt version. The research and context run tables stay read-only
// history once the `research_pass` job is on.

enum PassKind {
  first
  later
}

enum PassStatus {
  running
  completed
  skipped
  failed
}

enum VersionKind {
  first
  update
  legacy
}

/// At most one `current` version per story: the partial unique index `article_versions_one_current`, raw SQL in the 20261117230407_research_passes migration. Prisma cannot model it and leaves it out of its diffs; check:migrations fails on a migration that drops it
enum VersionStatus {
  current
  superseded
  reverted
}

enum FactDropReason {
  contradicted
  editor
}

/// One research pass on one story (`research_pass` job, or an editor's). A deleted story's passes keep a null story_id, so the month's spend still counts them. `cost_usd` holds the reservation while it runs, then the measured cost (ADR-0055)
model ResearchPass {
  id            String             @id @default(uuid())
  storyId       String?            @map("story_id")
  story         Story?             @relation(fields: [storyId], references: [id], onDelete: SetNull)
  /// 1… per story
  number        Int
  trigger       ResearchRunTrigger
  kind          PassKind
  status        PassStatus         @default(running)
  /// written, updated, unchanged, stale, contradicted, fallback, update_failed, budget or technical; null while running
  outcome       String?
  /// Research's gate verdict kind on a first pass; null otherwise
  verdict       String?
  costUsd       Float              @map("cost_usd")
  modelUsd      Float              @default(0) @map("model_usd")
  tavilyCredits Int                @default(0) @map("tavily_credits")
  /// Everything else the pass did: research's and context's run records, and a later pass's judgments
  record        Json?
  /// Why a pass failed, sanitized: never fetched text
  error         String?
  startedAt     DateTime           @default(now()) @map("started_at")
  finishedAt    DateTime?          @map("finished_at")
  /// The article version the pass produced, or null
  versionId     String?            @unique @map("version_id")
  version       ArticleVersion?    @relation("PassVersion", fields: [versionId], references: [id], onDelete: SetNull)
  searches      EvidenceSearch[]
  sourcesFound  EvidenceSource[]   @relation("SourceFirstPass")
  sourcesOut    EvidenceSource[]   @relation("SourceDropPass")
  factsFound    PoolFact[]         @relation("FactFirstPass")
  factsChecked  PoolFact[]         @relation("FactCheckedPass")
  factsDropped  PoolFact[]         @relation("FactDroppedPass")
  versions      ArticleVersion[]   @relation("VersionPass")
  boxes         PassBox[]

  @@unique([storyId, number])
  @@index([startedAt])
  @@map("research_passes")
}

/// One web search a pass made, or a legacy run made (null pass_id): the skip list, so a normalized query and a `response` angle are searched once per story
model EvidenceSearch {
  id              String        @id @default(uuid())
  storyId         String        @map("story_id")
  story           Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  passId          String?       @map("pass_id")
  pass            ResearchPass? @relation(fields: [passId], references: [id], onDelete: SetNull)
  /// coverage (what other outlets reported) or gap (a card slot's search)
  kind            String
  /// A gap search's slot; null for coverage
  slot            String?
  /// A `response` search's angle (action, elsewhere)
  angle           String?
  query           String
  normalizedQuery String        @map("normalized_query")
  windowStart     DateTime?     @map("window_start") @db.Date
  windowEnd       DateTime?     @map("window_end") @db.Date
  /// basic or advanced
  depth           String?
  credits         Int           @default(0)
  results         Int           @default(0)
  cached          Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([storyId])
  @@map("evidence_searches")
}

/// One source per story (Evidence): the pages a pass read, our earlier stories it drew on, and the pages it read and left out (`drop_reason`), so no later pass reads them again. No page text is stored
model EvidenceSource {
  id             String        @id @default(uuid())
  storyId        String        @map("story_id")
  story          Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// S0 (the original), S1… or E1… (our earlier stories), stable within the story; null for a source left out
  ref            String?
  /// original, cluster, neighbour, search or earlier
  origin         String
  /// The earlier story an `earlier` source stands for (no foreign key: that story may be deleted)
  earlierStoryId String?       @map("earlier_story_id")
  url            String
  /// The story's key for the source: `normalizedUrl`, or `story:<id>` for an earlier story
  normalizedUrl  String        @map("normalized_url")
  outlet         String        @default("")
  title          String        @default("")
  publishedDate  DateTime?     @map("published_date") @db.Date
  kind           String        @default("other")
  country        String        @default("")
  relation       String        @default("")
  favicon        String?
  usedRawContent Boolean       @default(false) @map("used_raw_content")
  /// [{ name, role, quote }], each quote word for word
  voices         Json          @default("[]")
  firstPassId    String?       @map("first_pass_id")
  firstPass      ResearchPass? @relation("SourceFirstPass", fields: [firstPassId], references: [id], onDelete: SetNull)
  optOutChecked  Boolean       @default(false) @map("opt_out_checked")
  /// Why a read source was left out (unusable, off-topic, opt-out …); null for a source in use
  dropReason     String?       @map("drop_reason")
  dropPassId     String?       @map("drop_pass_id")
  dropPass       ResearchPass? @relation("SourceDropPass", fields: [dropPassId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  facts          PoolFact[]

  @@unique([storyId, normalizedUrl])
  @@unique([storyId, ref])
  @@map("evidence_sources")
}

/// One fact per story in the pool (`fact_key`: its page, supporting sentence and statement, normalized), checked once. Evidence columns, the extraction's and structure's judgment, the check's judgment, and its status: a demotion is a status change with its pass and reason
model PoolFact {
  id                     String          @id @default(uuid())
  storyId                String          @map("story_id")
  story                  Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceId               String          @map("source_id")
  source                 EvidenceSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// S2F3: its source's ref and a number within it, stable within the story, as citations and cards cite it
  ref                    String
  factKey                String          @map("fact_key")
  /// A fact offered from a linked earlier story: that story's pool fact (no foreign key)
  reusedFromId           String?         @map("reused_from_id")
  /// Copied verbatim from the source
  supportingSentence     String          @map("supporting_sentence")
  /// The sentence with one sentence either side, at most 600 characters; null when not kept
  passage                String?
  supportFound           Boolean         @default(false) @map("support_found")
  statement              String
  measures               String          @default("")
  value                  Float?
  valueHigh              Float?          @map("value_high")
  unit                   String          @default("")
  approx                 String          @default("exact")
  provisional            Boolean         @default(false)
  counted                String          @default("")
  place                  String          @default("")
  asOf                   DateTime?       @map("as_of") @db.Date
  asOfPrecision          String?         @map("as_of_precision")
  credited               String          @default("")
  creditedKind           String?         @map("credited_kind")
  validity               ContextValidity @default(fixed)
  /// The card slot a gap search's fact was extracted for
  slot                   String?
  extractModel           String          @map("extract_model")
  extractPromptVersion   String          @map("extract_prompt_version")
  /// The call that gave the structured fields; null until a pass structured the fact
  structureModel         String?         @map("structure_model")
  structurePromptVersion String?         @map("structure_prompt_version")
  firstPassId            String?         @map("first_pass_id")
  firstPass              ResearchPass?   @relation("FactFirstPass", fields: [firstPassId], references: [id], onDelete: SetNull)
  verdict                ContextVerdict  @default(unjudged)
  verdictProblem         String?         @map("verdict_problem")
  checkModel             String?         @map("check_model")
  checkPromptVersion     String?         @map("check_prompt_version")
  checkedPassId          String?         @map("checked_pass_id")
  checkedPass            ResearchPass?   @relation("FactCheckedPass", fields: [checkedPassId], references: [id], onDelete: SetNull)
  status                 JudgmentStatus  @default(unreviewed)
  droppedPassId          String?         @map("dropped_pass_id")
  droppedPass            ResearchPass?   @relation("FactDroppedPass", fields: [droppedPassId], references: [id], onDelete: SetNull)
  dropReason             FactDropReason? @map("drop_reason")
  /// The refs of the newer facts that contradict a demoted one
  contradictedBy         String[]        @default([]) @map("contradicted_by")
  createdAt              DateTime        @default(now()) @map("created_at")

  @@unique([storyId, factKey])
  @@unique([storyId, ref])
  @@index([sourceId])
  @@map("pool_facts")
}

/// One researched version of the article. The story's own columns stay the live copy readers read; versions are the history and the source of Updates
model ArticleVersion {
  id               String        @id @default(uuid())
  storyId          String        @map("story_id")
  story            Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  number           Int
  passId           String?       @map("pass_id")
  pass             ResearchPass? @relation("VersionPass", fields: [passId], references: [id], onDelete: SetNull)
  producedBy       ResearchPass? @relation("PassVersion")
  kind             VersionKind
  status           VersionStatus @default(current)
  title            String?
  titleLabel       String?       @map("title_label")
  summary          String?
  marketingBlurb   String?       @map("marketing_blurb")
  quote            String?
  quoteAttribution String?       @map("quote_attribution")
  relevanceReasons String?       @map("relevance_reasons")
  antifactors      String?
  emotionTag       EmotionTag?   @map("emotion_tag")
  /// The reader projection (researchedStorySchema)
  research         Json
  /// [{ section, before: CitedText | null, after: CitedText | null }]
  changes          Json          @default("[]")
  /// The Update readers see, with its citations; null for a first or legacy version
  note             Json?
  createdAt        DateTime      @default(now()) @map("created_at")

  @@unique([storyId, number])
  @@map("article_versions")
}

/// The cards a pass wrote: context_boxes' columns, citing pool facts by their story-level ref. The newest pass that wrote boxes is the one served
model PassBox {
  id            String         @id @default(uuid())
  storyId       String         @map("story_id")
  story         Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  passId        String         @map("pass_id")
  pass          ResearchPass   @relation(fields: [passId], references: [id], onDelete: Cascade)
  position      Int
  type          ContextBoxType
  heading       String
  teaser        String         @default("")
  /// [{ text, factIds }], each fact id a pool fact's ref
  sentences     Json
  visual        Json?
  asOf          DateTime?      @map("as_of") @db.Date
  asOfPrecision String?        @map("as_of_precision")
  place         String?
  placeByEditor Boolean        @default(false) @map("place_by_editor")
  status        JudgmentStatus @default(unreviewed)
  model         String?
  promptVersion String?        @map("prompt_version")
  writtenAt     DateTime       @default(now()) @map("written_at")

  @@index([storyId])
  @@index([passId])
  @@map("pass_boxes")
}

/// One row per show and ISO week whose Saturday publish slot found no weekly episode to publish: the claim that makes the missed-week alert go out once
model PodcastMissedWeekAlert {
  edition PodcastEdition @default(full)
  weekKey String         @map("week_key")
  reason  String
  sentAt  DateTime       @default(now()) @map("sent_at")

  @@id([edition, weekKey])
  @@map("podcast_missed_week_alerts")
}

model JobRun {
  id              String    @id @default(uuid())
  jobName         String    @unique @map("job_name")
  lastStartedAt   DateTime? @map("last_started_at")
  lastCompletedAt DateTime? @map("last_completed_at")
  lastSucceededAt DateTime? @map("last_succeeded_at")
  lastError       String?   @map("last_error")
  enabled         Boolean   @default(true)
  cronExpression  String    @map("cron_expression")
  // Cross-instance run lease (scheduler.ts): who holds it, and until when (UTC, database clock)
  lockedBy        String?   @map("locked_by")
  lockedUntil     DateTime? @map("locked_until")
  // Consecutive runs cut off before they finished (shutdown at the drain deadline, or a process that
  // died); a normal finish resets it. Bounds the automatic resume (interruptedRuns.ts)
  interruptedRuns Int       @default(0) @map("interrupted_runs")
  // Model calls at OpenAI flex price, with a fall back to standard (services/openaiFetch.ts)
  flex            Boolean   @default(true)
  // A chain's step: the chain waits for a person after this step (jobs/chains.ts)
  pauseForReview  Boolean   @default(false) @map("pause_for_review")
  // A chain's step, "HH:MM" UTC: the chain holds before this step until this time comes round after
  // the run's start (a daytime social post after a night-time chain): "HH:MM", or "Sat 07:00" for a
  // weekday, on the step's own clock (jobs/jobTimeZones.ts, else UTC). Null for no hold
  notBefore       String?   @map("not_before")
  // A chain's flex cut-off, in hours from the start of each run (any schedule, once or several times
  // a day): calls go at standard price after it. Null on other jobs, and for flex the whole run
  flexHours       Float?    @map("flex_hours")
  // A chain's place to go on from: the step running now ('running'), the step after a review pause
  // ('review'), the step held for its time ('waiting', going on at resumeAt), or the step it stopped
  // at ('failed'); null when its last run ended normally
  resumeStep      String?   @map("resume_step")
  resumeReason    String?   @map("resume_reason")
  resumeAt        DateTime? @map("resume_at")
  // A chain's current run: when it started from its first step; a step's hold counts from it
  chainStartedAt  DateTime? @map("chain_started_at")
  // What the last finished run spent (lib/runUsage.ts RunUsage): calls, tokens, USD
  lastRunUsage    Json?     @map("last_run_usage")
  lastRunSummary  String?   @map("last_run_summary")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("job_runs")
}

/// What each job spent in each UTC month, added to by every finished run that recorded its usage (jobs/jobLease.ts finishJobRun; .context/scheduler.md, "Spending"), and by an editor's context run as a run of build_story_context. A chain's own runs add nothing: its steps' runs carry its spend. An interrupted run's spend is lost
model JobMonthSpend {
  jobName         String   @map("job_name")
  /// The first day of the UTC month, on the database clock
  month           DateTime @db.Date
  /// USD as billed (flex calls at flex price), web searches included
  costUsd         Float    @default(0) @map("cost_usd")
  standardCostUsd Float    @default(0) @map("standard_cost_usd")
  /// The part of cost_usd spent on web searches; AI spend is cost_usd minus search_usd
  searchUsd       Float    @default(0) @map("search_usd")
  searchCredits   Int      @default(0) @map("search_credits")
  runs            Int      @default(0)

  @@id([jobName, month])
  @@map("job_month_spend")
}

/// A monthly warning level in whole USD (services/spending.ts): per job, for research started by an editor (`editor_research`) or for the total (`all`). Passing it, or heading past it at the month's pace, records a notice, at most one of each kind per scope and month; nothing stops on it
model SpendWarning {
  scope    String @id
  levelUsd Int    @map("level_usd")

  @@map("spend_warnings")
}

// --- Story retention (.context/story-retention.md) ---

// Counts of stories the cleanup_old_stories job deleted, so lifetime totals survive the deletion.
// Append-only: each delete batch adds its own rows, so readers always SUM "story_count". No foreign
// keys: the feed or issue may change later, the counts stay as they were.
model StoryArchiveCount {
  id           String   @id @default(uuid())
  crawlMonth   DateTime @db.Date @map("crawl_month")
  feedId       String   @map("feed_id")
  issueId      String?  @map("issue_id")
  status       String
  relevancePre Int?     @map("relevance_pre")
  relevance    Int?
  emotionTag   String?  @map("emotion_tag")
  storyCount   Int      @map("story_count")
  archivedAt   DateTime @default(now()) @map("archived_at")

  @@index([crawlMonth])
  @@map("story_archive_counts")
}

// --- Bluesky Tables ---

model BlueskyPost {
  id               String    @id @default(uuid())
  storyId          String    @unique @map("story_id")
  story            Story     @relation(fields: [storyId], references: [id])
  postUri          String?   @unique @map("post_uri")
  postCid          String?   @map("post_cid")
  status           String    @default("draft") // draft | published | failed
  postText         String    @map("post_text")
  error            String?
  publishedAt      DateTime? @map("published_at")
  likeCount        Int       @default(0) @map("like_count")
  repostCount      Int       @default(0) @map("repost_count")
  replyCount       Int       @default(0) @map("reply_count")
  quoteCount       Int       @default(0) @map("quote_count")
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("bluesky_posts")
}

// --- Mastodon Tables ---

model MastodonPost {
  id               String    @id @default(uuid())
  storyId          String    @unique @map("story_id")
  story            Story     @relation(fields: [storyId], references: [id])
  statusId         String?   @unique @map("status_id")
  statusUrl        String?   @map("status_url")
  status           String    @default("draft") // draft | published | failed
  postText         String    @map("post_text")
  error            String?
  publishedAt      DateTime? @map("published_at")
  favouriteCount   Int       @default(0) @map("favourite_count")
  boostCount       Int       @default(0) @map("boost_count")
  replyCount       Int       @default(0) @map("reply_count")
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("mastodon_posts")
}

// --- Subscription Tables ---

model PendingSubscription {
  id             String    @id @default(uuid())
  email          String
  token          String    @unique
  plunkContactId String?   @map("plunk_contact_id")
  confirmedAt    DateTime? @map("confirmed_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  // When the confirmation email went out; null while the signup waits in the queue for the
  // send_queued_confirmations job. A row written without it counts as sent (the default).
  sentAt         DateTime? @default(now()) @map("sent_at")
  /// The edition chosen at signup, written to the Plunk contact's `edition` field on confirm (ADR-0052)
  edition        NewsletterEdition @default(full)

  @@index([email])
  @@map("pending_subscriptions")
}

/// A subscriber's latest switch of newsletter edition from an issue's footer link, one row per Plunk
/// contact, beside what Plunk holds; with the confirmed signups it tells the closed-editions guard
/// who is on Actually Uplifting (ADR-0052, services/knownEditions.ts). No address: the contact id only.
model EditionSwitch {
  plunkContactId String            @id @map("plunk_contact_id")
  edition        NewsletterEdition
  switchedAt     DateTime          @default(now()) @map("switched_at")

  @@map("edition_switches")
}

// --- Feedback Tables ---

enum FeedbackCategory {
  general
  bug
  suggestion
  other
  correction
}

enum FeedbackStatus {
  unread
  read
  archived
}

model Feedback {
  id        String           @id @default(uuid())
  category  FeedbackCategory
  message   String
  email     String?
  status    FeedbackStatus   @default(unread)
  ipHash    String           @map("ip_hash")
  // The story a "Report an error" was sent from; cleared when the story is deleted (retention).
  storyId   String?          @map("story_id")
  story     Story?           @relation(fields: [storyId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([storyId])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

// --- Admin notices (.context/admin-notices.md) ---

// Every owner alert: job failures, podcast and newsletter notices, the signup cap, Plunk
// complaints and bounces. `source` and `severity` are checked in services/adminNotices.ts, not
// Postgres enums, so a new source needs no migration. A repeat of a `dedupeKey` folds into its row.
model AdminNotice {
  id              String    @id @default(uuid())
  source          String
  severity        String
  title           String
  message         String
  link            String?
  dedupeKey       String?   @unique @map("dedupe_key")
  count           Int       @default(1)
  firstOccurredAt DateTime  @default(now()) @map("first_occurred_at")
  lastOccurredAt  DateTime  @default(now()) @map("last_occurred_at")
  seenAt          DateTime? @map("seen_at")

  @@index([seenAt, lastOccurredAt])
  @@map("admin_notices")
}

// --- Auth Tables ---

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(viewer)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
