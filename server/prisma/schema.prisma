generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// --- Enums ---

enum StoryStatus {
  fetched
  pre_analyzed
  analyzed
  selected
  published
  rejected
  trashed
}

enum EmotionTag {
  uplifting
  frustrating
  scary
  calm
}

enum FeedRegion {
  north_america
  western_europe
  eastern_europe
  middle_east_north_africa
  sub_saharan_africa
  south_southeast_asia
  pacific
  latin_america
  global
}

enum ContentStatus {
  draft
  published
}

enum UserRole {
  admin
  editor
  viewer
}

// --- Core Tables ---

model Story {
  id                     String       @id @default(uuid())
  sourceUrl              String       @unique @map("source_url")
  sourceTitle            String       @map("source_title")
  sourceContent          String       @map("source_content")
  sourceDatePublished    DateTime?    @map("source_date_published")
  feedId                 String       @map("feed_id")
  feed                   Feed         @relation(fields: [feedId], references: [id])
  issueId                String?      @map("issue_id")
  issue                  Issue?       @relation(fields: [issueId], references: [id])
  status                 StoryStatus  @default(fetched)
  dateCrawled            DateTime     @default(now()) @map("date_crawled")
  datePublished          DateTime?    @map("date_published")
  relevancePre           Int?         @map("relevance_pre")
  relevance              Int?
  emotionTag             EmotionTag?  @map("emotion_tag")
  slug                   String?      @unique
  title                  String?
  titleLabel             String?      @map("title_label")
  summary                String?
  quote                  String?
  quoteAttribution       String?      @map("quote_attribution")
  marketingBlurb         String?      @map("marketing_blurb")
  relevanceReasons       String?      @map("relevance_reasons")
  relevanceSummary       String?      @map("relevance_summary")
  antifactors            String?
  relevanceCalculation   String?      @map("relevance_calculation")
  crawlMethod            String?      @map("crawl_method")
  accessTier             String?      @map("access_tier")
  embedding              Unsupported("vector(1536)")?
  embeddingContentHash   String?      @db.VarChar(64) @map("embedding_content_hash")
  embeddingGeneratedAt   DateTime?    @map("embedding_generated_at")
  clusterId              String?      @map("cluster_id")
  cluster                StoryCluster? @relation("ClusterMember", fields: [clusterId], references: [id])
  primaryOfCluster       StoryCluster? @relation("ClusterPrimary")
  blueskyPosts           BlueskyPost[]
  mastodonPosts          MastodonPost[]
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@index([status, dateCrawled])
  @@index([feedId])
  @@index([status, relevancePre])
  @@index([status, relevance])
  @@index([datePublished])
  @@index([issueId])
  @@index([clusterId])
  @@map("stories")
}

model StoryCluster {
  id             String   @id @default(uuid())
  primaryStoryId String?  @unique @map("primary_story_id")
  primaryStory   Story?   @relation("ClusterPrimary", fields: [primaryStoryId], references: [id])
  stories        Story[]  @relation("ClusterMember")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("story_clusters")
}

model Feed {
  id                 String    @id @default(uuid())
  title              String
  rssUrl             String    @unique @map("rss_url")
  url                String?
  displayTitle       String?   @map("display_title")
  language           String    @default("en")
  region             FeedRegion?
  issueId            String    @map("issue_id")
  issue              Issue     @relation(fields: [issueId], references: [id])
  active             Boolean   @default(true)
  crawlIntervalHours Int       @default(24) @map("crawl_interval_hours")
  lastCrawledAt      DateTime? @map("last_crawled_at")
  lastCrawlError          String?   @map("last_crawl_error")
  lastCrawlErrorAt        DateTime? @map("last_crawl_error_at")
  consecutiveFailedCrawls Int       @default(0) @map("consecutive_failed_crawls")
  consecutiveEmptyCrawls  Int       @default(0) @map("consecutive_empty_crawls")
  lastSuccessfulCrawlAt   DateTime? @map("last_successful_crawl_at")
  lastEtag                String?   @map("last_etag")
  lastModified            String?   @map("last_modified")
  lastCrawlResult         String?   @map("last_crawl_result")
  htmlSelector            String?   @map("html_selector")
  paywallDetection        Boolean   @default(true) @map("paywall_detection")
  paywallTitleMarker      String?   @map("paywall_title_marker")
  stories            Story[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("feeds")
}

model Issue {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String   @default("")
  promptFactors      String   @default("") @map("prompt_factors")
  promptAntifactors  String   @default("") @map("prompt_antifactors")
  promptRatings      String   @default("") @map("prompt_ratings")
  parentId           String?  @map("parent_id")
  parent             Issue?   @relation("IssueHierarchy", fields: [parentId], references: [id])
  children           Issue[]  @relation("IssueHierarchy")
  intro              String   @default("")
  evaluationIntro    String   @default("") @map("evaluation_intro")
  evaluationCriteria String   @default("") @map("evaluation_criteria")
  makeADifference    String   @default("") @map("make_a_difference")
  minPreRating       Int?     @map("min_pre_rating")
  feeds              Feed[]
  stories            Story[]
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("issues")
}

model Newsletter {
  id        String           @id @default(uuid())
  title     String
  content   String           @default("")
  html      String           @default("")
  storyIds          String[]         @map("story_ids")
  selectedStoryIds  String[]         @default([]) @map("selected_story_ids")
  status            ContentStatus    @default(draft)
  /// ISO week (YYYY-Www) of the automatic weekly issue; set only by the generate_newsletter job
  weekKey   String?          @map("week_key")
  sends     NewsletterSend[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("newsletters")
}

enum NewsletterSendStatus {
  draft
  scheduled
  sending
  sent
  failed
}

model NewsletterSend {
  id              String               @id @default(uuid())
  newsletterId    String               @map("newsletter_id")
  newsletter      Newsletter           @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  plunkCampaignId String?              @map("plunk_campaign_id")
  isTest          Boolean              @default(false) @map("is_test")
  status          NewsletterSendStatus @default(draft)
  htmlContent     String               @map("html_content")
  stats           Json                 @default("{}")
  errorMessage    String?              @map("error_message")
  sentAt          DateTime?            @map("sent_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([newsletterId])
  @@index([plunkCampaignId])
  @@map("newsletter_sends")
}

/// Production progress of a podcast episode (forward-only; `legacy` = rows from before the two-speaker pipeline).
/// Publication is the separate `status` axis.
enum PodcastStage {
  legacy
  created
  selected
  scripted
  voiced
  ready
}

/// How far a run goes: automated runs straight to `ready`; interactive stops after `selected` and `scripted` for review
enum PodcastMode {
  automated
  interactive
}

/// weekly: this ISO week's episode (the jobs' only kind); standalone: built by hand from any published stories, never touched by the jobs (ADR-0016)
enum PodcastKind {
  weekly
  standalone
}

model Podcast {
  id             String        @id @default(uuid())
  title          String
  /// Legacy rows: the hand-voiced script. Two-speaker rows: the rendered dialogue ("HOST A: ...") for the admin.
  script         String        @default("")
  storyIds       String[]      @map("story_ids")
  status         ContentStatus @default(draft)
  /// ISO week in UTC (YYYY-Www) of the weekly episode; null for legacy and standalone rows
  weekKey        String?       @unique @map("week_key")
  /// Weekly or standalone; a CHECK (podcasts_standalone_without_week_key) keeps a standalone row's week key null
  kind           PodcastKind   @default(weekly)
  stage          PodcastStage  @default(created)
  /// The model's dialogue (segments of turns, storyRef = episodeStories[].ref)
  dialogue       Json?
  /// Snapshot of the episode's stories (ref, id, title, publisher, sourceUrl, slug, issue), frozen at scripting
  episodeStories Json?         @map("episode_stories")
  episodeSummary String        @default("") @map("episode_summary")
  showNotes      String        @default("") @map("show_notes")
  scriptModelId  String?       @map("script_model_id")
  lastError      String?       @map("last_error")
  failedAt       DateTime?     @map("failed_at")
  /// Automatic (cron) failures this week; reset by an admin Resume
  attempts       Int           @default(0)
  blockedAt      DateTime?     @map("blocked_at")
  blockedReason  String?       @map("blocked_reason")
  /// Cross-process lease on the stage machine: owner = a per-process id, until = database clock
  leaseOwner     String?       @map("lease_owner")
  leaseUntil     DateTime?     @map("lease_until")
  dryRun         Boolean       @default(false) @map("dry_run")
  /// TTS model and voices the episode was voiced with (stored at `voiced`)
  ttsModelId     String?       @map("tts_model_id")
  voiceIds       Json?         @map("voice_ids")
  /// Public CDN URLs and storage paths of the MP3 and the VTT transcript (stored at `ready`); a fresh file name per render
  audioUrl       String?       @map("audio_url")
  audioPath      String?       @map("audio_path")
  transcriptUrl  String?       @map("transcript_url")
  transcriptPath String?       @map("transcript_path")
  audioBytes     Int?          @map("audio_bytes")
  durationSec    Int?          @map("duration_sec")
  readyAt        DateTime?     @map("ready_at")
  /// Null until a person (or the cron run) chooses how far runs go
  mode           PodcastMode?
  /// A person changed the stories or the script text; selects the episode's AI line
  humanEdited    Boolean       @default(false) @map("human_edited")
  /// TTS seed of the current render; null = config.podcast.ttsSeed. A fresh one per "Regenerate audio"
  ttsSeed        Int?          @map("tts_seed")
  /// When the stories were selected: the end of the week's pool the model chose from, which the story picker lists too
  storiesSelectedAt DateTime?  @map("stories_selected_at")
  /// First publication; once set the episode is never regenerated or deleted (its GUID and enclosure are permanent)
  publishedAt    DateTime?     @map("published_at")
  /// Last takedown; the automatic publish job never republishes an episode that has one
  unpublishedAt  DateTime?     @map("unpublished_at")
  /// When the generate_podcast job reminded the owner that this interactive episode waits for him (once per week)
  reviewReminderSentAt DateTime? @map("review_reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  audioChunks PodcastAudioChunk[]
  ttsUsage    PodcastTtsUsage[]

  @@map("podcasts")
}

/// One voiced TTS chunk of an episode, kept until the episode's MP3 is assembled and uploaded (`ready`)
model PodcastAudioChunk {
  id         String   @id @default(uuid())
  podcastId  String   @map("podcast_id")
  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  index      Int
  bytes      Bytes
  requestId  String?  @map("request_id")
  chars      Int
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([podcastId, index])
  @@map("podcast_audio_chunks")
}

/// TTS spend ledger: one row per reserved TTS call, kept whatever the call's outcome and after the episode is deleted
model PodcastTtsUsage {
  id        String   @id @default(uuid())
  podcastId String?  @map("podcast_id")
  podcast   Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  chars     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("podcast_tts_usage")
}

/// One row per ISO week whose Saturday publish slot found no weekly episode to publish: the claim that makes the missed-week alert go out once
model PodcastMissedWeekAlert {
  weekKey String   @id @map("week_key")
  reason  String
  sentAt  DateTime @default(now()) @map("sent_at")

  @@map("podcast_missed_week_alerts")
}

model JobRun {
  id              String    @id @default(uuid())
  jobName         String    @unique @map("job_name")
  lastStartedAt   DateTime? @map("last_started_at")
  lastCompletedAt DateTime? @map("last_completed_at")
  lastSucceededAt DateTime? @map("last_succeeded_at")
  lastError       String?   @map("last_error")
  enabled         Boolean   @default(true)
  cronExpression  String    @map("cron_expression")
  // Cross-instance run lease (scheduler.ts): who holds it, and until when (UTC, database clock)
  lockedBy        String?   @map("locked_by")
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("job_runs")
}

// --- Bluesky Tables ---

model BlueskyPost {
  id               String    @id @default(uuid())
  storyId          String    @unique @map("story_id")
  story            Story     @relation(fields: [storyId], references: [id])
  postUri          String?   @unique @map("post_uri")
  postCid          String?   @map("post_cid")
  status           String    @default("draft") // draft | published | failed
  postText         String    @map("post_text")
  error            String?
  publishedAt      DateTime? @map("published_at")
  likeCount        Int       @default(0) @map("like_count")
  repostCount      Int       @default(0) @map("repost_count")
  replyCount       Int       @default(0) @map("reply_count")
  quoteCount       Int       @default(0) @map("quote_count")
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("bluesky_posts")
}

// --- Mastodon Tables ---

model MastodonPost {
  id               String    @id @default(uuid())
  storyId          String    @unique @map("story_id")
  story            Story     @relation(fields: [storyId], references: [id])
  statusId         String?   @unique @map("status_id")
  statusUrl        String?   @map("status_url")
  status           String    @default("draft") // draft | published | failed
  postText         String    @map("post_text")
  error            String?
  publishedAt      DateTime? @map("published_at")
  favouriteCount   Int       @default(0) @map("favourite_count")
  boostCount       Int       @default(0) @map("boost_count")
  replyCount       Int       @default(0) @map("reply_count")
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("mastodon_posts")
}

// --- Subscription Tables ---

model PendingSubscription {
  id             String    @id @default(uuid())
  email          String
  token          String    @unique
  plunkContactId String?   @map("plunk_contact_id")
  confirmedAt    DateTime? @map("confirmed_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("pending_subscriptions")
}


// --- Feedback Tables ---

enum FeedbackCategory {
  general
  bug
  suggestion
  other
}

enum FeedbackStatus {
  unread
  read
  archived
}

model Feedback {
  id        String           @id @default(uuid())
  category  FeedbackCategory
  message   String
  email     String?
  status    FeedbackStatus   @default(unread)
  ipHash    String           @map("ip_hash")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

// --- Admin notices (.context/admin-notices.md) ---

// Every owner alert: job failures, podcast and newsletter notices, the signup cap, Plunk
// complaints and bounces. `source` and `severity` are checked in services/adminNotices.ts, not
// Postgres enums, so a new source needs no migration. A repeat of a `dedupeKey` folds into its row.
model AdminNotice {
  id              String    @id @default(uuid())
  source          String
  severity        String
  title           String
  message         String
  link            String?
  dedupeKey       String?   @unique @map("dedupe_key")
  count           Int       @default(1)
  firstOccurredAt DateTime  @default(now()) @map("first_occurred_at")
  lastOccurredAt  DateTime  @default(now()) @map("last_occurred_at")
  seenAt          DateTime? @map("seen_at")

  @@index([seenAt, lastOccurredAt])
  @@map("admin_notices")
}

// --- Auth Tables ---

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(viewer)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
