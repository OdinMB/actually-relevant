// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHtml > renders a full issue while the editions are closed exactly as before the editions 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Week 45, 2026</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <!-- Inbox preview text -->
  <div style="display: none; max-height: 0; max-width: 0; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; color: #f5f5f5; mso-hide: all;">AI-curated: Two · Three</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
          <!-- Web edition -->
          <tr>
            <td style="padding: 12px 32px 0; text-align: center;">
              <a href="https://actuallyrelevant.news/newsletter/week-45-2026" style="font-size: 12px; color: #a3a3a3; text-decoration: underline;">View in browser</a>
            </td>
          </tr>
          <!-- Header -->
          <tr>
            <td style="padding: 20px 32px 0; text-align: center;">
              <!-- The logo cropped to its ink (block, fixed height): the full logo's built-in white band
                   and an inline image's line-box gap left a wide hole above the tagline in mail clients -->
              <a href="https://actuallyrelevant.news" style="display: block; text-decoration: none;">
                <img src="https://actuallyrelevant.news/images/logo-email.jpg" alt="Actually Relevant" width="200" height="44" style="display: block; margin: 0 auto; width: 200px; max-width: 200px; height: 44px; border: 0;" />
              </a>
              <p style="margin: 8px 0 0; font-size: 15px; font-style: italic; color: #a3a3a3; line-height: 1.4;">News that matter to humanity</p>
            </td>
          </tr>
          <!-- Color strip -->
          <tr>
            <td style="padding: 18px 0 0; font-size: 0; line-height: 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
                <td style="width: 25%; height: 4px; background-color: #fbbf24;"></td>
                <td style="width: 25%; height: 4px; background-color: #2dd4bf;"></td>
                <td style="width: 25%; height: 4px; background-color: #f87171;"></td>
                <td style="width: 25%; height: 4px; background-color: #818cf8;"></td>
              </tr></table>
            </td>
          </tr>
          <tr>
            <td style="padding: 14px 32px 0; text-align: center;">
              <p style="margin: 0; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #404040;">Week 45, 2026</p>
              <!-- AI label at the top of every issue, not only in the footer (AI Act Art. 50(4)) -->
              <p style="margin: 8px 0 0; font-size: 13px; color: #525252; line-height: 1.5;"><span style="display: inline-block; padding: 1px 4px; border: 1px solid #525252; border-radius: 3px; font-size: 10px; font-weight: 700; line-height: 1; letter-spacing: 0.05em; vertical-align: middle;">AI</span> selected the stories in this issue and wrote the headlines and summaries.</p>
            </td>
          </tr>

          <!-- Stories -->
          <tr>
            <td style="padding: 8px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                
    <tr>
      <td style="padding: 32px 0 12px; text-align: center;">
        <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto;"><tr>
          <td style="vertical-align: middle; padding-right: 12px;"><div style="width: 40px; border-top: 1px solid #e5e5e5;"></div></td>
          <td style="vertical-align: middle; padding-right: 8px; line-height: 0;"><div style="width: 10px; height: 10px; border-radius: 50%; background-color: #2dd4bf;"></div></td>
          <td style="vertical-align: middle; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #404040; white-space: nowrap;">Climate</td>
          <td style="vertical-align: middle; padding-left: 12px;"><div style="width: 40px; border-top: 1px solid #e5e5e5;"></div></td>
        </tr></table>
      </td>
    </tr>

    <tr>
      <td style="padding: 20px 0 4px;">
        <h2 style="margin: 0 0 6px; font-size: 20px; font-weight: 700; color: #171717; line-height: 1.3;"><a href="https://example.com/smog" style="color: #171717; text-decoration: none;">Cities cut smog</a></h2>
        <p style="margin: 0 0 12px; font-size: 13px; color: #737373; line-height: 20px;"><span style="vertical-align: middle;">BBC</span> <span style="vertical-align: middle;">&middot;</span> <a href="https://example.com/smog" style="color: #2563eb; text-decoration: none; vertical-align: middle;">original article</a> <span style="vertical-align: middle;">&middot;</span> <a href="https://actuallyrelevant.news/stories/smog" style="color: #2563eb; text-decoration: none; vertical-align: middle;">relevance analysis</a></p>
        <p style="margin: 0 0 10px; font-size: 15px; color: #525252; line-height: 1.6;">A third less.</p>
      </td>
    </tr>
              </table>
            </td>
          </tr>

          <!-- Support -->
          <tr>
            <td style="padding: 28px 32px; text-align: center; border-top: 1px solid #e5e5e5;">
              <p style="margin: 0 0 14px; font-size: 14px; color: #525252; line-height: 1.5;">Actually Relevant is free, with no ads and no investors, but running it costs money. If this issue was worth something to you, please chip in.</p>
              <a href="https://ko-fi.com/odinmb" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 10px 24px; font-size: 14px; font-weight: 600; color: #ffffff; background-color: #171717; border-radius: 8px; text-decoration: none;">&#10084; Donate $5 toward running the site</a>
            </td>
          </tr>

          <!-- AI disclosure -->
          <tr>
            <td style="padding: 28px 32px 16px; text-align: center; border-top: 1px solid #e5e5e5;">
              <p style="margin: 0; font-size: 16px; font-style: italic; color: #737373;">Curated and written with care by AI</p>
              <p style="margin: 12px 0 0; font-size: 13px; color: #a3a3a3; line-height: 1.5;">Our app might have bugs. AI can make mistakes.<br>If something seems off, please reply to this email and let us know.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 20px 32px 24px; text-align: center; background-color: #fafafa; border-top: 1px solid #e5e5e5; margin-top: 16px;">
              <p style="margin: 0 0 10px; font-size: 12px; color: #a3a3a3;">
                <a href="https://actuallyrelevant.news" style="color: #2563eb; text-decoration: none;">actuallyrelevant.news</a>
              </p>
              <p style="margin: 0 0 10px; font-size: 12px; color: #a3a3a3;">
                <a href="https://bsky.app/profile/actuallyrelevant.bsky.social" style="color: #737373; text-decoration: none; vertical-align: middle;"><img src="https://actuallyrelevant.news/images/social/bluesky.png" alt="Bluesky" width="14" height="14" style="display: inline-block; width: 14px; height: 14px; vertical-align: middle; margin-right: 3px;">Bluesky</a>
                <span style="color: #d4d4d4; margin: 0 6px;">&middot;</span>
                <a href="https://mastodon.social/@actuallyrelevant" rel="me" style="color: #737373; text-decoration: none; vertical-align: middle;"><img src="https://actuallyrelevant.news/images/social/mastodon.png" alt="Mastodon" width="14" height="14" style="display: inline-block; width: 14px; height: 14px; vertical-align: middle; margin-right: 3px;">Mastodon</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>"
`;
