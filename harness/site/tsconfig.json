{
  // Type-checks the invented fixtures against the shared types and the client's API types, so a
  // renamed or retyped field fails test/fixtures-types.test.mjs. Nothing is emitted.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@shared/*": ["../../shared/*"]
    }
  },
  "files": ["lib/fixtures.mjs", "../../client/src/vite-env.d.ts"]
}
